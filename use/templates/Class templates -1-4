#include <iostream>

// 1. Pair

template <typename T1, typename T2>
class Pair {
private:
    T1 first;
    T2 second;

public:
    Pair(T1 a, T2 b) {
        first = a;
        second = b;
    }

    void display() {
        std::cout << first << " " << second << std::endl;
    }
};


// 2. FixedArray

template <typename T, int N>
class FixedArray {
private:
    T array[N];

public:
    void set(int index, T value) {
        array[index] = value;
    }

    T get(int index) {
        return array[index];
    }

    int size() {
        return N;
    }
};


// 3. Matrix

template <typename T, int N, int M>
class Matrix {
private:
    T matrix[N][M];

public:
    void set(int row, int col, T value) {
        matrix[row][col] = value;
    }

    T get(int row, int col) {
        return matrix[row][col];
    }

    void print() {
        for (int i = 0; i < N; i++) {
            for (int j = 0; j < M; j++) {
                std::cout << matrix[i][j] << " ";
            }
            std::cout << std::endl;
        }
    }

    Matrix<T, N, M> operator+(const Matrix<T, N, M>& other) {
        Matrix<T, N, M> result;

        for (int i = 0; i < N; i++) {
            for (int j = 0; j < M; j++) {
                result.matrix[i][j] = matrix[i][j] + other.matrix[i][j];
            }
        }

        return result;
    }
};


// 4. Range

template <typename T>
class Range {
private:
    T start;
    T end;

public:
    Range(T a, T b) {
        start = a;
        end = b;
    }

    bool contains(const T& value) {
        return value >= start && value <= end;
    }

    T length() {
        return end - start;
    }

    void print() {
        std::cout << "[" << start << ", " << end << "]" << std::endl;
    }
};


int main() {

    // 1. Pair
    Pair<int, double> p(5, 3.5);
    p.display();


    // 2. FixedArray
    FixedArray<int, 3> a;

    a.set(0, 10);
    a.set(1, 20);
    a.set(2, 30);

    std::cout << a.get(0) << " "
              << a.get(1) << " "
              << a.get(2) << std::endl;

    std::cout << a.size() << std::endl;

    FixedArray<double, 2> b;

    b.set(0, 1.5);
    b.set(1, 2.5);

    std::cout << b.get(0) << " "
              << b.get(1) << std::endl;


    // 3. Matrix
    Matrix<int, 2, 2> m1;

    m1.set(0, 0, 1);
    m1.set(0, 1, 2);
    m1.set(1, 0, 3);
    m1.set(1, 1, 4);

    Matrix<int, 2, 2> m2;

    m2.set(0, 0, 5);
    m2.set(0, 1, 6);
    m2.set(1, 0, 7);
    m2.set(1, 1, 8);

    Matrix<int, 2, 2> m3 = m1 + m2;

    m3.print();

    Matrix<double, 2, 2> m4;

    m4.set(0, 0, 1.5);
    m4.set(0, 1, 2.5);
    m4.set(1, 0, 3.5);
    m4.set(1, 1, 4.5);

    m4.print();


    // 4. Range
    Range<int> r1(3, 10);

    r1.print();
    std::cout << r1.contains(5) << std::endl;
    std::cout << r1.length() << std::endl;

    Range<double> r2(1.5, 5.5);

    r2.print();
    std::cout << r2.contains(3.0) << std::endl;
    std::cout << r2.length() << std::endl;

    Range<char> r3('a', 'f');

    r3.print();
    std::cout << r3.contains('c') << std::endl;
    std::cout << r3.length() << std::endl;

    return 0;
}
